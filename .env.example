# AROVA — Environment Variables Example
# Copy this file to .env.local and fill in your keys

# ── The Graph Subgraph Studio API Key ─────────────────────────────────────────
# Get your key from: https://thegraph.com/studio → API Keys
GRAPH_API_KEY=your_subgraph_studio_api_key_here

# ── Google Gemini API Key ──────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
